# Copy to .env and adjust. Every value here is optional. .env is gitignored,
# so key ids and credentials belong there rather than here.

# ---------------------------------------------------------------- containers
# R version of the builder image; picks the tag, eg jammy-r-4.6.1. Must be a
# tag that exists:
#   docker manifest inspect ghcr.io/bioconductor/bioc2u-builder:noble-r-4.6.1
R_VERSION=4.6.1
#BUILDER_IMAGE_REPO=ghcr.io/bioconductor/bioc2u-builder

# Where the .debs and the build state live, one subdirectory per distro. A
# full release needs about 260 GB per distro here; see README.md, Disk.
# Relative paths must start with ./ and are relative to this directory.
#BIOC2U_DEBS_ROOT=/mnt/bioc2u/debs

# ------------------------------------------------------------------- packages
# Bioconductor release to build. Empty = whatever the image's BiocManager is
# pinned to; build_all.sh refuses a value the image disagrees with.
#BIOC_VERSION=3.23

# Refuse to continue a debs directory that belongs to a different release.
# Set to 1 only after clearing done-*/fail-*/packages.json yourself.
#BIOC2U_ALLOW_RELEASE_CHANGE=0

# Migration aid: also provide this older ABI from BiocVersion, so carried-over
# packages stay installable. Leave unset for a clean release build. See
# ../docs/operations.md.
#BIOC2U_ALSO_PROVIDE_ABI=r-api-bioc-3.22

# Maintainer field of the generated packages.
DEBEMAIL=maintainer@bioconductor.org
DEBFULLNAME=Bioconductor Core Team

# Re-resolve the dependency graph instead of resuming the existing one.
# Needed after a release, or to pick up new packages.
#BIOC2U_REFRESH_DEPS=1

# Lines of build log to print when a package fails (0 to print none).
#BIOC2U_LOG_TAIL=50
# set -x in the per-package build.
#BIOC2U_TRACE=1

# ------------------------------------------------------------------ uploading
# Only used by the *-upload services.
#DEB_S3_ENDPOINT=https://mghp.osn.xsede.org
#DEB_S3_BUCKET=bir190004-bucket01
#DEB_S3_PREFIX=bioc2u
#DEB_S3_COMPONENT=release

# Key id the repository index is signed with; the secret key has to be in the
# keyring mounted below. Uploading refuses to run without it.
#GPG_SIGN_KEY=
#BIOC2U_ALLOW_UNSIGNED=1

# Credentials for the S3 endpoint: either mount the directory holding
# config/credentials, or set the keys directly.
#AWS_DIR=~/.aws
#AWS_PROFILE=default
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Keyring holding the signing key.
#GNUPG_DIR=~/.gnupg

# Print the deb-s3 command instead of publishing.
#BIOC2U_DRY_RUN=1
